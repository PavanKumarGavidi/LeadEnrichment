# Apollo.io API key (required)
APOLLO_API_KEY=your_apollo_api_key_here

# Shared password for team login (required)
TEAM_PASSWORD=your_team_password_here

# Session secret - any random string (required)
SESSION_SECRET=generate_a_random_secret_string_here

# Server port (default: 3000)
PORT=3000

# Set to "true" when deployed behind HTTPS (e.g. Render, Railway, Fly.io)
SECURE_COOKIES=false
